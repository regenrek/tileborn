# Workspace dependencies and build output
node_modules/
dist/
build/
# `src/build/` directories are SOURCE (e.g. apps/game-host/src/build,
# packages/services-build/src/build), not build output — re-include them.
!**/src/build/
!**/src/build/**
out/
coverage/
*.lcov
*.tsbuildinfo
.tmp/
.cache/
.cursor/

# Cloudflare, env, and local machine state
.alchemy/
.wrangler/
.mf/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Logs and diagnostics
logs/
*.log
*.err
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
test-results/

# Internal agent documentation, not for the OSS repo. Keep the directory
# traversable so the three public creator/release contracts can ship.
/docs/*
!/docs/battle-royale-creator-guide.md
!/docs/battle-royale-release-evidence.md
!/docs/game-mode-extension.md

# Package artifacts and caches
*.tgz
.npm/
/.pnpm-store/
.parcel-cache/
.eslintcache
.stylelintcache
dist-smoke/

# Third-party local asset imports, not for the OSS repo
packages/test-fixtures/fixtures/asset-packs/[a]ncient/

# Electron
release/
.electron-builder/

# Vite
.vite/
*.local

# Generated local bundles
apps/game-host/src/.generated/

# TypeScript emits accidentally written next to package sources
packages/ipc-contracts/src/**/*.d.ts
packages/ipc-contracts/src/**/*.d.ts.map
packages/ipc-contracts/src/**/*.js
packages/ipc-contracts/src/**/*.js.map
packages/runtime-wasm/src/**/*.d.ts
packages/runtime-wasm/src/**/*.d.ts.map
packages/runtime-wasm/src/**/*.js
packages/runtime-wasm/src/**/*.js.map

# OS/editor noise
.DS_Store
._*
.vscode/
.idea/

# Git merge leftovers
*.orig
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
# tsconfig.base.json is a real tracked config (the whole monorepo extends it),
# not a merge artifact — the case-insensitive *.BASE.* glob matches it on macOS.
!tsconfig.base.json


.plandb
.turbo
.refs
project.json
project.lock.json
