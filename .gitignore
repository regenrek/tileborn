# Workspace dependencies and build output
node_modules/
dist/
build/
# This CC0 fixture intentionally models an installed plugin's compiled entry.
!packages/test-fixtures/fixtures/plugins/smoke-fixture/dist/
!packages/test-fixtures/fixtures/plugins/smoke-fixture/dist/runtime.js
# `src/build/` directories are SOURCE (e.g. apps/game-host/src/build,
# packages/services-build/src/build), not build output — re-include them.
!**/src/build/
!**/src/build/**
# Planr build plans are durable planning contracts, not generated build output.
!/.planr/plans/build/
!/.planr/plans/build/*.plan.md
out/
coverage/
*.lcov
*.tsbuildinfo
.tmp/
.cache/
.cursor/
.codex/
.claude/
.envrc

# Cloudflare, env, and local machine state
.alchemy/
.wrangler/
.mf/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Logs and diagnostics
/logs/
*.log
*.err
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
test-results/

# Internal agent documentation, not for the OSS repo. Keep the directory
# traversable so the public creator/release contracts and the canonical
# docs-build inputs can ship from a clean checkout.
/docs/*
!/docs/battle-royale-creator-guide.md
!/docs/battle-royale-release-evidence.md
!/docs/desktop-release-capability-audit.md
!/docs/desktop-release-runbook.md
!/docs/game-mode-extension.md
!/docs/persisted-schema-compatibility.md
!/docs/03-runtime-game-host.md
!/docs/follow-ups.md
!/docs/adrs/
!/docs/adrs/**

# Package artifacts and caches
*.tgz
.npm/
/.pnpm-store/
.parcel-cache/
.eslintcache
.stylelintcache
dist-smoke/

# Credentials, private keys, and infrastructure state
.aws/credentials
.netrc
.git-credentials
.docker/config.json
*.pem
*.key
*.p12
*.jks
*.keystore
id_rsa
id_ed25519
id_ecdsa
id_dsa
*.agekey
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
secrets.json
tokens.json
credentials.json
service-account*.json

# Planr durable plans, project contracts, agent profiles, and the archived
# review baseline are tracked explicitly. The SQLite database and newly emitted
# review projections are local orchestration state and must not dirty product
# branches.
/.planr/planr.sqlite
/.planr/planr.sqlite-*
/.planr/reviews/*.review.md

# Third-party local asset imports, not for the OSS repo
packages/test-fixtures/fixtures/asset-packs/[a]ncient/

# Electron
release/
.electron-builder/

# Vite
.vite/
*.local

# Generated local bundles
apps/game-host/src/.generated/

# TypeScript emits accidentally written next to package sources
packages/ipc-contracts/src/**/*.d.ts
packages/ipc-contracts/src/**/*.d.ts.map
packages/ipc-contracts/src/**/*.js
packages/ipc-contracts/src/**/*.js.map
packages/runtime-wasm/src/**/*.d.ts
packages/runtime-wasm/src/**/*.d.ts.map
packages/runtime-wasm/src/**/*.js
packages/runtime-wasm/src/**/*.js.map

# OS/editor noise
.DS_Store
._*
.vscode/
.idea/

# Git merge leftovers
*.orig
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
# tsconfig.base.json is a real tracked config (the whole monorepo extends it),
# not a merge artifact — the case-insensitive *.BASE.* glob matches it on macOS.
!tsconfig.base.json


.plandb
.turbo
.refs
project.json
project.lock.json
