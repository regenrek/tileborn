{
  "name": "@tileborne/desktop",
  "version": "1.0.0-rc.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "clean:vite-deps": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('node_modules/.vite/deps', { recursive: true, force: true }); console.log('Removed desktop Vite optimized deps cache. Restart the dev server to rebuild stale pre-bundled deps.');\"",
    "predev:cdp": "echo \"[t-fix-r-f3-predev-build][ADR-0015] Building desktop workspace dist dependencies before CDP dev, then rebundling game-host worker.\" && pnpm -w -r --workspace-concurrency=1 --filter '@tileborne/desktop^...' --filter '!tileborne' build && pnpm --filter @tileborne/game-host build",
    "dev:cdp": "TILEBORNE_REMOTE_DEBUGGING_PORT=9323 node ../../node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['out', '.vite/build']) rmSync(path, { recursive: true, force: true });\"",
    "build": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js package",
    "package": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js make",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:renderer-boot": "vitest run --config vitest.electron.config.ts",
    "test:electron-smoke": "vitest run --config vitest.electron.config.ts",
    "test:packaged-smoke": "vitest run --config vitest.smoke.config.ts src/smoke/packaged-runtime-closure.smoke.spec.ts",
    "test:creator-performance-native": "vitest run --config vitest.electron.config.ts src/smoke/creator-performance-native.electron.test.ts",
    "verify:electron-main-local-behavior": "node scripts/verify-electron-main-local-behavior.mjs",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:desktop-smoke": "pnpm test:electron-smoke && pnpm test:smoke",
    "test:all": "pnpm test && pnpm test:smoke"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@fontsource-variable/ibm-plex-sans": "5.2.8",
    "@pixi/tilemap": "5.0.2",
    "@remixicon/react": "4.9.0",
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-router": "1.170.5",
    "@tanstack/react-virtual": "3.13.26",
    "@tileborne/asset-pipeline": "workspace:*",
    "@tileborne/core": "workspace:*",
    "@tileborne/game-client": "workspace:*",
    "@tileborne/game-host": "workspace:*",
    "@tileborne/ipc-contracts": "workspace:*",
    "@tileborne/plugin-api": "workspace:*",
    "@tileborne/plugin-battle-royale": "workspace:*",
    "@tileborne/plugin-example-arena": "workspace:*",
    "@tileborne/runtime": "workspace:*",
    "@tileborne/sdk-tileset": "workspace:*",
    "@tileborne/services-app": "workspace:*",
    "@tileborne/services-build": "workspace:*",
    "@tileborne/services-foundation": "workspace:*",
    "@tileborne/services-plugin": "workspace:*",
    "@tileborne/test-fixtures": "workspace:*",
    "@tileborne/ui": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-beta.70",
    "esbuild": "0.28.1",
    "lucide-react": "0.511.0",
    "miniflare": "4.20260603.0",
    "msgpackr": "2.0.1",
    "pixi.js": "8.18.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query-devtools": "5.100.11",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.7",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "42.2.0",
    "jsdom": "26.1.0",
    "shadcn": "4.10.0",
    "tailwindcss": "4.3.0",
    "vite": "8.0.16",
    "vitest": "4.1.7"
  },
  "config": {
    "forge": "./electron-forge.config.cjs"
  },
  "license": "MIT"
}
