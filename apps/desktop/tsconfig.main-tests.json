{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main-tests.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "composite": false,
    "rootDir": ".",
    "outDir": "./node_modules/.tmp/tsc/main-tests",
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client", "node", "electron", "vitest"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@tileborne/game-client": ["../../packages/game-client/src/index.ts"],
      "@tileborne/services-foundation": ["../../packages/services-foundation/src/index.ts"],
      "@tileborne/services-app": ["../../packages/services-app/src/index.ts"],
      "@tileborne/services-plugin": ["../../packages/services-plugin/src/index.ts"],
      "@tileborne/services-build": ["../../packages/services-build/src/index.ts"]
    }
  },
  "files": ["src/main/__tests__/map-editor-playtest-owner.integration.test.tsx"],
  "include": [
    "src/main/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/main/**/*.test.ts",
    "src/main/**/*.test.tsx",
    "src/renderer/**/*.test.ts",
    "src/renderer/**/*.test.tsx",
    "src/smoke/**/*"
  ],
  "references": [
    { "path": "../../packages/game-client" },
    { "path": "../../packages/ipc-contracts" },
    { "path": "../../packages/services-foundation" },
    { "path": "../../packages/services-app" },
    { "path": "../../packages/services-plugin" },
    { "path": "../../packages/services-build" }
  ]
}
