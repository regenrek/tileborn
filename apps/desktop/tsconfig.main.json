{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main.tsbuildinfo",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron"],
    "composite": true,
    "rootDir": ".",
    "outDir": "./node_modules/.tmp/tsc/main",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@tileborne/services-foundation": ["../../packages/services-foundation/src/index.ts"],
      "@tileborne/services-app": ["../../packages/services-app/src/index.ts"],
      "@tileborne/services-plugin": ["../../packages/services-plugin/src/index.ts"],
      "@tileborne/services-build": ["../../packages/services-build/src/index.ts"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "vite.main.config.ts",
    "vite.cjs-import-meta-url.ts"
  ],
  "references": [
    { "path": "../../packages/ipc-contracts" },
    { "path": "../../packages/services-foundation" },
    { "path": "../../packages/services-app" },
    { "path": "../../packages/services-plugin" },
    { "path": "../../packages/services-build" }
  ]
}
