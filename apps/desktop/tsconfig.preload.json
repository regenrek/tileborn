{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.preload.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron"],
    "composite": true,
    "rootDir": ".",
    "outDir": "./node_modules/.tmp/tsc/preload",
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "vite.preload.config.ts",
    "vite.cjs-import-meta-url.ts"
  ],
  "references": [{ "path": "../../packages/ipc-contracts" }]
}
