{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals"]
  },
  "include": [".astro/types.d.ts", ".astro/content.d.ts", "src/**/*", "vitest.config.ts"],
  "exclude": ["dist", "node_modules", ".astro"]
