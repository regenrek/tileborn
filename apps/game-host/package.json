{
  "name": "@tileborne/game-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/cloudflare.d.ts",
      "default": "./dist/build/cloudflare.js"
    },
    "./local": {
      "types": "./dist/local/launcher.d.ts",
      "default": "./dist/local/launcher.js"
    },
    "./behavior-node": {
      "types": "./dist/behavior/node/index.d.ts",
      "default": "./dist/behavior/node/index.js"
    }
  },
  "scripts": {
    "generate:bundled": "node scripts/generate-bundled-modules.mjs",
    "prebuild": "node scripts/generate-bundled-modules.mjs",
    "pretypecheck": "node scripts/generate-bundled-modules.mjs",
    "pretest": "node scripts/generate-bundled-modules.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.smoke.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:smoke:cloudflare": "vitest run --config vitest.cloudflare-smoke.config.ts",
    "verify:bundled-worker": "node scripts/verify-bundled-worker.mjs",
    "build": "tsc -b tsconfig.json && node scripts/bundle-worker.mjs"
  },
  "dependencies": {
    "@tileborne/core": "workspace:*",
    "@tileborne/ipc-contracts": "workspace:*",
    "@tileborne/runtime": "workspace:*",
    "effect": "4.0.0-beta.78",
    "esbuild": "0.25.5",
    "hono": "4.12.32",
    "miniflare": "4.20260603.0",
    "msgpackr": "2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@cloudflare/workers-types": "4.20250508.0",
    "@tileborne/plugin-battle-royale": "workspace:*",
    "@tileborne/test-fixtures": "workspace:*",
    "@types/node": "22.19.19",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "wrangler": "4.98.0"
  },
  "license": "MIT"
}
