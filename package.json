{
  "name": "tileborne",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:boundaries": "pnpm --filter @tileborne/boundary-tests test -- --run",
    "test:clean-checkout": "bash scripts/clean-checkout-smoke.sh",
    "test:clean-checkout-time": "bash scripts/clean-checkout-smoke.sh --time",
    "test:clean-checkout-time:validate": "vitest run --config vitest.config.ts scripts/clean-checkout-time/validate.test.ts",
    "test:cli-e2e": "pnpm --filter @tileborne/cli test:cli-e2e",
    "test:desktop-smoke": "pnpm --filter @tileborne/desktop test:desktop-smoke",
    "test:game-host": "pnpm --filter @tileborne/game-host test:smoke",
    "test:services-build-hermetic": "pnpm typecheck && pnpm --filter @tileborne/game-host verify:bundled-worker && pnpm --filter @tileborne/services-build test",
    "test:creator-performance": "vitest run --config vitest.config.ts scripts/creator-performance.test.ts scripts/creator-performance-owners.test.ts",
    "docs:build": "pnpm --filter @tileborne/docs build",
    "docs:dev": "pnpm --filter @tileborne/docs dev",
    "build": "turbo run build",
    "release:gate": "node scripts/release-gates.mjs run",
    "release:gates": "node scripts/release-gates.mjs run-all",
    "release:gates:matrix": "node scripts/release-gates.mjs matrix",
    "release:desktop:policy": "node scripts/desktop-release-contract.mjs policy",
    "release:desktop:status": "node scripts/desktop-release-contract.mjs status --expect no-go",
    "release:desktop:docs": "node scripts/release-docs-contract.mjs",
    "release:desktop:verify": "node scripts/desktop-release-contract.mjs verify",
    "test:release-gates": "vitest run --config vitest.config.ts scripts/release-gates.test.ts",
    "test:desktop-release-contract": "vitest run --config vitest.config.ts scripts/desktop-release-contract.test.ts scripts/release-docs.test.ts",
    "ci": "pnpm release:gates",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.4.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.8.3",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vitest": "4.1.7"
  }
}
