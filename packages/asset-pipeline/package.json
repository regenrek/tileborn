{
  "name": "@tileborne/asset-pipeline",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./license": {
      "types": "./dist/license/index.d.ts",
      "default": "./dist/license/index.js"
    },
    "./pack": {
      "types": "./dist/pack/index.d.ts",
      "default": "./dist/pack/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@tileborne/core": "workspace:*",
    "effect": "4.0.0-beta.78"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "MIT"
}
