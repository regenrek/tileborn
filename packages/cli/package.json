{
  "name": "@tileborne/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tileborne": "./dist/main.js",
    "tb": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:cli-e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@tileborne/asset-pipeline": "workspace:*",
    "@tileborne/core": "workspace:*",
    "@tileborne/runtime": "workspace:*",
    "@tileborne/runtime-wasm": "workspace:*",
    "@tileborne/sdk-tileset": "workspace:*",
    "@tileborne/services-app": "workspace:*",
    "@tileborne/services-build": "workspace:*",
    "@tileborne/services-foundation": "workspace:*",
    "@tileborne/services-plugin": "workspace:*",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "effect": "4.0.0-beta.70"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "MIT"
}
