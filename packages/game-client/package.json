{
  "name": "@tileborne/game-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/menu.css": "./src/styles/menu.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --config eslint.config.js",
    "test": "vitest run",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'tsconfig.tsbuildinfo']) rmSync(path, { recursive: true, force: true });\" && tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@tileborne/core": "workspace:*",
    "@tileborne/ipc-contracts": "workspace:*",
    "@tileborne/plugin-api": "workspace:*",
    "@tileborne/runtime": "workspace:*",
    "@tileborne/ui": "workspace:*",
    "effect": "4.0.0-beta.78"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
