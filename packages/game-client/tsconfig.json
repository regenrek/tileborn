{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "sourceMap": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.tsx", "src/**/*.test.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../ipc-contracts" },
    { "path": "../plugin-api" },
    { "path": "../ui" }
  ]
}
