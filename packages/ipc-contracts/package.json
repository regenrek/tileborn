{
  "name": "@tileborne/ipc-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./protocols/battle-royale": {
      "types": "./dist/protocols/battle-royale.d.ts",
      "default": "./dist/protocols/battle-royale.js"
    },
    "./contracts/multiplayer": {
      "types": "./dist/contracts/multiplayer.d.ts",
      "default": "./dist/contracts/multiplayer.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@tileborne/core": "workspace:*",
    "@tileborne/plugin-api": "workspace:*",
    "@tileborne/sdk-tileset": "workspace:*",
    "@tileborne/simulation": "workspace:*",
    "effect": "4.0.0-beta.78",
    "msgpackr": "2.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.78",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "MIT"
}
