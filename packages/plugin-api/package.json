{
  "name": "@tileborne/plugin-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./project-content": {
      "types": "./dist/project-content.d.ts",
      "default": "./dist/project-content.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.examples.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@tileborne/asset-pipeline": "workspace:*",
    "@tileborne/core": "workspace:*",
    "@tileborne/simulation": "workspace:*",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "MIT"
}
