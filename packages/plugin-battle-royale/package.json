{
  "name": "@tileborne/plugin-battle-royale",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "generate:assets": "node scripts/generate-content-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsup"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./menu": {
      "types": "./src/menu/index.tsx",
      "default": "./dist/menu.js"
    },
    "./authoring": {
      "types": "./src/authoring/index.ts",
      "default": "./dist/authoring.js"
    },
    "./renderer": {
      "types": "./src/renderer/index.ts",
      "default": "./dist/renderer.js"
    },
    "./player-models": {
      "types": "./src/player-models/index.ts",
      "default": "./dist/player-models.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "default": "./dist/policy.js"
    },
    "./dist/runtime.js": "./dist/runtime.js",
    "./dist/server.js": "./dist/server.js"
  },
  "peerDependencies": {
    "react": "19.2.6"
  },
  "dependencies": {
    "@tileborne/core": "workspace:*",
    "@tileborne/game-client": "workspace:*",
    "@tileborne/ipc-contracts": "workspace:*",
    "@tileborne/plugin-api": "workspace:*",
    "@tileborne/runtime": "workspace:*",
    "@tileborne/simulation": "workspace:*",
    "@tileborne/sdk-tileset": "workspace:*",
    "@tileborne/ui": "workspace:*",
    "effect": "4.0.0-beta.78",
    "lucide-react": "0.511.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@tileborne/services-plugin": "workspace:*",
    "@types/react": "19.2.14",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
