{
  "schemaVersion": 1,
  "panels": [
    {
      "id": "br-settings",
      "label": "Battle Royale Settings",
      "description": "Configure zone shrink timing, player cap, and loot density for authored maps.",
      "fields": [
        {
          "key": "zoneShrinkIntervalSec",
          "type": "number",
          "label": "Zone shrink interval (seconds)",
          "description": "Time between safe-zone radius reductions.",
          "default": 60,
          "min": 10,
          "max": 300
        },
        {
          "key": "maxPlayers",
          "type": "number",
          "label": "Max players",
          "description": "Maximum concurrent players supported by the authored arena.",
          "default": 32,
          "min": 2,
          "max": 100
        },
        {
          "key": "lootDensity",
          "type": "number",
          "label": "Loot density",
          "description": "Relative loot crate density from 0 (sparse) to 1 (dense).",
          "default": 0.5,
          "min": 0,
          "max": 1
        },
        {
          "key": "matchMode",
          "type": "enum",
          "label": "Match mode",
          "default": "solo",
          "options": ["solo", "duo", "squad"]
        }
      ]
    }
  ]
}
