{
  "schemaVersion": 1,
  "types": [
    {
      "id": "spawn-point",
      "displayName": "Spawn Point",
      "description": "Player spawn location for battle royale matches.",
      "category": "gameplay",
      "icon": "lucide:map-pin",
      "propertiesSchema": {
        "type": "object",
        "properties": {
          "team": {
            "type": "string",
            "enum": ["solo", "duo", "squad"]
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["team"]
      },
      "defaults": {
        "team": "solo",
        "weight": 1
      }
    },
    {
      "id": "shrink-zone-anchor",
      "displayName": "Shrink Zone Anchor",
      "description": "Center anchor for the closing safe zone.",
      "category": "gameplay",
      "icon": "lucide:circle-dashed",
      "propertiesSchema": {
        "type": "object",
        "properties": {
          "initialRadiusTiles": {
            "type": "number",
            "minimum": 1
          },
          "finalRadiusTiles": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["initialRadiusTiles", "finalRadiusTiles"]
      },
      "defaults": {
        "initialRadiusTiles": 48,
        "finalRadiusTiles": 4
      }
    },
    {
      "id": "loot-crate",
      "displayName": "Loot Crate",
      "description": "World loot spawn used by battle royale drop tables.",
      "category": "gameplay",
      "icon": "lucide:package",
      "propertiesSchema": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string",
            "enum": ["common", "rare", "epic"]
          },
          "respawnSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["tier"]
      },
      "defaults": {
        "tier": "common",
        "respawnSeconds": 0
      }
    }
  ]
}
