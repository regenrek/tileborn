  "compilerOptions": {
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../core" },
    { "path": "../ipc-contracts" },
    { "path": "../runtime" },
    { "path": "../plugin-api" },
    { "path": "../simulation" },
    { "path": "../ui" },
    { "path": "../game-client" }
  ]
}
