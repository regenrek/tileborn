{
  "name": "@tileborne/runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./map-package": {
      "types": "./dist/map-package/index.d.ts",
      "default": "./dist/map-package/index.js"
    },
    "./net": {
      "types": "./dist/net/index.d.ts",
      "default": "./dist/net/index.js"
    },
    "./behavior": {
      "types": "./dist/behavior/index.d.ts",
      "default": "./dist/behavior/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@pixi/tilemap": "5.0.2",
    "@tileborne/asset-pipeline": "workspace:*",
    "@tileborne/core": "workspace:*",
    "@tileborne/plugin-api": "workspace:*",
    "effect": "4.0.0-beta.78",
    "msgpackr": "2.0.1",
    "pixi.js": "8.18.1"
  },
  "devDependencies": {
    "vitest": "4.1.7"
  },
  "license": "MIT"
}
