{
  "name": "@tileborne/services-build",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local-game-host": {
      "types": "./dist/local-game-host.d.ts",
      "default": "./dist/local-game-host.js"
    }
  },
  "scripts": {
    "prepare:game-host-worker": "pnpm --filter @tileborne/game-host build",
    "prebuild": "pnpm run prepare:game-host-worker",
    "pretest": "pnpm run prepare:game-host-worker && tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@tileborne/game-host": "workspace:*",
    "@tileborne/asset-pipeline": "workspace:*",
    "@tileborne/core": "workspace:*",
    "@tileborne/game-sdk": "workspace:*",
    "@tileborne/plugin-api": "workspace:*",
    "@tileborne/runtime": "workspace:*",
    "@tileborne/services-app": "workspace:*",
    "@tileborne/services-foundation": "workspace:*",
    "@tileborne/services-plugin": "workspace:*",
    "effect": "4.0.0-beta.70",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "MIT"
}
