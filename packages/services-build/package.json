{
  "name": "@tileborne/services-build",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local-game-host": {
      "types": "./dist/local-game-host.d.ts",
      "default": "./dist/local-game-host.js"
    },
    "./reference-game/battle-royale": {
      "types": "./dist/reference-game/battle-royale.d.ts",
      "default": "./dist/reference-game/battle-royale.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.78",
    "@tileborne/game-host": "workspace:*",
    "@tileborne/asset-pipeline": "workspace:*",
    "@tileborne/core": "workspace:*",
    "@tileborne/game-sdk": "workspace:*",
    "@tileborne/ipc-contracts": "workspace:*",
    "@tileborne/plugin-api": "workspace:*",
    "@tileborne/runtime": "workspace:*",
    "@tileborne/services-app": "workspace:*",
    "@tileborne/services-foundation": "workspace:*",
    "@tileborne/services-plugin": "workspace:*",
    "alchemy": "2.0.0-beta.55",
    "effect": "4.0.0-beta.102",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@tileborne/plugin-battle-royale": "workspace:*",
    "@types/node": "22.19.19",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "license": "MIT"
}
