{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["TILEBORNE_SOURCE_COMMIT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/**", "out/**"]
    },
    "@tileborne/game-host#build": {
      "dependsOn": ["@tileborne/plugin-battle-royale#build", "^build"],
      "outputs": ["dist/**"]
    },
    "@tileborne/game-host#typecheck": {
      "dependsOn": ["@tileborne/plugin-battle-royale#build", "^typecheck", "build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "@tileborne/cli#test": {
      "dependsOn": ["^build", "build"]
    },
    "@tileborne/desktop#test": {
      "dependsOn": ["^build"]
    },
    "@tileborne/game-host#test": {
      "dependsOn": ["^build", "build"]
    },
    "@tileborne/game-sdk#test": {
      "dependsOn": ["^build", "build"]
    },
    "@tileborne/ipc-contracts#test": {
      "dependsOn": ["^build", "build"]
    },
    "@tileborne/plugin-battle-royale#test": {
      "dependsOn": ["^build", "build"]
    },
    "@tileborne/services-app#test": {
      "dependsOn": ["^build", "build"]
    },
    "@tileborne/services-build#test": {
      "dependsOn": ["@tileborne/cli#build", "^build", "build"]
    },
    "@tileborne/ui#test": {
      "dependsOn": ["^build", "build"]
    },
    "test:cli-e2e": {
      "dependsOn": ["^build", "build"]
    },
    "test:boundaries": {
      "dependsOn": ["^build", "build"]
    },
    "test:desktop-smoke": {
      "dependsOn": ["^build", "build"]
    },
    "test:smoke": {
      "dependsOn": ["^build", "build"]
    },
    "docs:build": {
      "dependsOn": ["^build", "build"],
      "outputs": ["dist/**"]
    }
  }
}
